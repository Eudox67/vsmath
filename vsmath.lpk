<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="vsmath"/>
    <Type Value="RunTime"/>
    <Author Value="vsmath Contributors"/>
    <License Value="Apache-2.0"/>
    <Description Value="Single-precision SIMD matrix/vector math for Free Pascal"/>
